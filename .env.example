# Copy this file to .env at the repository root and fill secret values locally.

# Runtime and routing
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=40000
NEXT_PUBLIC_ENABLE_DEMO_CATALOG=false

# MongoDB
MONGODB_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# API and session security
INTERNAL_API_KEY=
JSON_BODY_LIMIT=1mb
SESSION_SECRET=
AUTH_COOKIE_NAME=craftigari_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# OTP authentication / StartMessaging
OTP_HASH_SECRET=
OTP_PROVIDER=startmessaging
OTP_API_KEY=
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DISABLE_LIMITS=false
OTP_TEST_MODE=false
OTP_TEST_PHONE_NUMBERS=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI service
APP_NAME=Craftigari AI Service
ENVIRONMENT=development
LOG_LEVEL=INFO
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Sarvam AI (Speech-to-Text & Translation)
VOICE_TRANSLATION_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

# BHASHINI (Preserved for rollback)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

